<UserControl x:Class="MonitorAudioSwitcher.ProfileCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ui:Card x:Name="Root" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
        <StackPanel>
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBadge" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                    <ui:SymbolIcon x:Name="HeaderIcon" FontSize="22" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border x:Name="ActivePill" Grid.Column="2" Style="{StaticResource Pill}" Background="#263DD68C" Visibility="Collapsed">
                    <TextBlock Text="ACTIVE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OkBrush}" />
                </Border>
            </Grid>

            <!-- Displays -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="DISPLAYS" />
            <ItemsControl x:Name="MonitorList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource RowBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ModeText}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Pill}" Background="#22FFFFFF">
                                    <Border.Visibility>
                                        <Binding Path="Primary">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </Border.Visibility>
                                    <TextBlock Text="Primary" FontSize="11" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoDisplayText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6" />
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CapturedText" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ui:Button Grid.Column="1" Content="Capture current layout" Icon="{ui:SymbolIcon Camera24}" Click="Capture_Click"
                           ToolTip="Saves exactly what Windows is showing right now (monitors, resolution, refresh rate, position)." />
            </Grid>

            <!-- Audio -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="AUDIO OUTPUT" />
            <ComboBox x:Name="AudioCombo" SelectionChanged="AudioCombo_SelectionChanged" />

            <!-- Hotkey -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="HOTKEY (OPTIONAL)" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="HotkeyBox" IsReadOnly="True" PlaceholderText="Click, then press a key combo (e.g. Ctrl+Alt+F1)"
                            PreviewKeyDown="HotkeyBox_PreviewKeyDown" IsReadOnlyCaretVisible="False" />
                <ui:Button Grid.Column="1" Margin="6,0,0,0" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Clear hotkey" Click="ClearHotkey_Click" />
            </Grid>

            <ui:Button x:Name="ApplyButton" Margin="0,18,0,0" HorizontalAlignment="Stretch" Appearance="Primary" Height="38"
                       Icon="{ui:SymbolIcon Play24}" Click="Apply_Click" />
        </StackPanel>
    </ui:Card>
</UserControl>
