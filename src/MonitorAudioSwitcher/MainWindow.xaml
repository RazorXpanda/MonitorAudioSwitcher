<ui:FluentWindow x:Class="MonitorAudioSwitcher.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:MonitorAudioSwitcher"
                 Title="Monitor &amp; Audio Switcher"
                 Width="1060" Height="820" MinWidth="880" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Monitor &amp; Audio Switcher" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,4,24,24">

                <!-- Status header -->
                <ui:Card Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot" Width="12" Height="12" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusTitle" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusDetail" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ProgressRing x:Name="BusyRing" IsIndeterminate="True" Width="22" Height="22" Margin="0,0,16,0" Visibility="Collapsed" />
                            <TextBlock Text="Auto-switch" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                            <ui:ToggleSwitch x:Name="AutoToggle" Click="AutoToggle_Click" />
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Profiles -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <local:ProfileCard x:Name="DeskCard" Grid.Column="0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowRight24" FontSize="22" Foreground="{StaticResource TvAccent}" />
                        <TextBlock Text="opens" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,18" />
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="22" Foreground="{StaticResource DeskAccent}" />
                        <TextBlock Text="closes" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <local:ProfileCard x:Name="TvCard" Grid.Column="2" />
                </Grid>

                <!-- Right now + settings -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:Card Grid.Column="0" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Right now" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ui:Button HorizontalAlignment="Right" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Refresh" Click="Refresh_Click" />
                            </Grid>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="CONNECTED DISPLAYS" />
                            <ItemsControl x:Name="CurrentMonitors">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Margin="2,0,12,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#55FFFFFF" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Active}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ModeText}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="Primary" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}">
                                                <TextBlock.Visibility>
                                                    <Binding Path="Primary">
                                                        <Binding.Converter>
                                                            <BooleanToVisibilityConverter />
                                                        </Binding.Converter>
                                                    </Binding>
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="DEFAULT AUDIO" />
                            <TextBlock x:Name="CurrentAudio" FontWeight="SemiBold" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Column="2" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" />

                            <TextBlock Style="{StaticResource SectionLabel}" Text="TRIGGER (WINDOW TITLE OR PROCESS.EXE)" />
                            <ui:TextBox x:Name="TriggerBox" PlaceholderText="Steam Big Picture Mode" LostFocus="TriggerBox_LostFocus" KeyDown="TriggerBox_KeyDown" />

                            <TextBlock Style="{StaticResource SectionLabel}" Text="SWITCH BACK TO DESK AFTER IT CLOSES FOR" />
                            <ComboBox x:Name="DelayCombo" SelectionChanged="DelayCombo_SelectionChanged" />

                            <Grid Margin="0,16,0,0">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Run when I sign in to Windows" FontWeight="SemiBold" />
                                    <TextBlock Text="Starts quietly in the tray." FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="StartupToggle" HorizontalAlignment="Right" Click="StartupToggle_Click" />
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Restore Desk when Windows shuts down" FontWeight="SemiBold" />
                                    <TextBlock Text="So the next boot and sign-in screen appear on your desk monitor, even if you shut down from Big Picture." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ShutdownToggle" HorizontalAlignment="Right" Click="ShutdownToggle_Click" />
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Restore Desk when the app starts" FontWeight="SemiBold" />
                                    <TextBlock Text="Safety net: if Big Picture isn't open at sign-in, make sure the desk layout is active." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="LaunchToggle" HorizontalAlignment="Right" Click="LaunchToggle_Click" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <!-- Activity -->
                <ui:Card Margin="0,14,0,0" Padding="20">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Activity" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ui:Button HorizontalAlignment="Right" Content="Open log file" Icon="{ui:SymbolIcon DocumentText24}" Click="OpenLog_Click" />
                        </Grid>
                        <ItemsControl x:Name="ActivityList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="24,10" Background="#10FFFFFF">
            <Grid>
                <TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           Text="Closing this window keeps the switcher running in the tray." />
                <ui:Button HorizontalAlignment="Right" Content="Exit app" Icon="{ui:SymbolIcon Power24}" Click="Exit_Click" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
